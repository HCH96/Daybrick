#!/bin/sh
# 커밋 전 검사 두 가지. 켜기 (저장소를 새로 받았을 때 한 번): git config core.hooksPath .githooks
# 1) 비밀값 검사 (gitleaks): 커밋에 넣는 내용만 보고, 키·토큰이 있으면 커밋을 막는다. 규칙은 .gitleaks.toml.
# 2) 문서 링크 검사: 문서·스크립트·앱 소스가 커밋에 들어 있을 때만 검사하고, 새로 깨진 링크가 있으면 커밋을 막는다.
#    링크 검사는 작업 폴더 기준이다 (커밋에 넣지 않은 수정도 함께 본다).

# --- 1) 비밀값 검사 ---
GITLEAKS=$(command -v gitleaks 2>/dev/null)
if [ -z "$GITLEAKS" ] && [ -n "$LOCALAPPDATA" ]; then
  # winget으로 설치한 직후에는 PATH가 아직 안 바뀐 셸이 있어서 설치 폴더를 직접 찾는다.
  for f in "$LOCALAPPDATA"/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_*/gitleaks.exe; do
    [ -f "$f" ] && GITLEAKS="$f" && break
  done
fi
if [ -z "$GITLEAKS" ]; then
  echo "커밋을 멈췄다: gitleaks가 없다 (공개 저장소라 비밀값 검사 없이 커밋하지 않는다)."
  echo "설치: winget install --id Gitleaks.Gitleaks -e  (macOS: brew install gitleaks)"
  exit 1
fi
if ! "$GITLEAKS" git --pre-commit --staged --redact --no-banner --verbose -c .gitleaks.toml; then
  echo ""
  echo "커밋을 멈췄다: 커밋할 내용에 비밀값으로 보이는 것이 있다. 위 파일·줄에서 값을 빼고 .env로 옮긴 뒤 다시 커밋한다."
  echo "비밀값이 아닌 것이 잘못 걸렸으면 그 줄 끝에 'gitleaks:allow' 주석을 단다."
  exit 1
fi

# --- 2) 문서 링크 검사 ---
if git diff --cached --name-only --diff-filter=ACDMR | grep -qE '^(docs/|\.claude/|[^/]+\.md$|apps/[^/]+/src/|apps/[^/]+/CLAUDE\.md$|supabase/.*\.md$)'; then
  if ! node .claude/scripts/check-links.mjs; then
    echo ""
    echo "커밋을 멈췄다: 새로 깨진 문서 링크가 있다. 위 목록을 고친 뒤 다시 커밋한다."
    exit 1
  fi
fi
exit 0
