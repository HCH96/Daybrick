{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "desktop-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/desktop", "run", "dev"],
      "port": 1420
    },
    {
      "name": "desktop-web-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/desktop", "run", "dev", "--", "--port", "1430"],
      "port": 1430
    },
    {
      "name": "docs-mockups",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path');const r=p.resolve('docs');const t={'.html':'text/html; charset=utf-8','.css':'text/css','.js':'text/javascript','.svg':'image/svg+xml','.png':'image/png'};h.createServer((q,s)=>{const u=decodeURIComponent(q.url.split('?')[0]);const fp=p.join(r,u);if(!fp.startsWith(r)){s.writeHead(403);return s.end();}f.readFile(fp,(e,d)=>{if(e){s.writeHead(404);return s.end('not found');}s.writeHead(200,{'Content-Type':t[p.extname(fp)]||'application/octet-stream'});s.end(d);});}).listen(4173,'127.0.0.1');"],
      "port": 4173
    },
    {
      "name": "web-static",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path');const r=p.resolve('apps/web/public');const t={'.html':'text/html; charset=utf-8','.css':'text/css'};h.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u.endsWith('/'))u+='index.html';const fp=p.join(r,u);if(!fp.startsWith(r)){s.writeHead(403);return s.end();}f.readFile(fp,(e,d)=>{if(e){s.writeHead(404);return s.end('not found');}s.writeHead(200,{'Content-Type':t[p.extname(fp)]||'application/octet-stream'});s.end(d);});}).listen(4174,'127.0.0.1');"],
      "port": 4174
    }
  ]
}
